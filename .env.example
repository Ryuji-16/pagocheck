# ==============================================================================
# PagoCheck - Variables de Entorno (.env / .env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client (Frontend / Vite)
# ------------------------------------------------------------------------------
# URL del proyecto Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Llave anónima pública de Supabase (anon public key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Configuración de Pasarela de Verificación Bancaria (Frontend)
# ------------------------------------------------------------------------------
# Si VITE_SUPABASE_URL está configurada, el sistema usa automáticamente EdgeFunctionPaymentProvider.
# Si deseas forzar el proveedor simulado para pruebas locales/offline, descomenta:
# VITE_FORCE_MOCK_PROVIDER=true

# ------------------------------------------------------------------------------
# 3. Secretos de Backend / Supabase Edge Functions (Banesco API)
# NOTA: Estas variables NO deben ir en el frontend ni en .env público.
# Se configuran en Supabase CLI mediante:
#   supabase secrets set BANESCO_API_URL=... BANESCO_CLIENT_ID=...
# ------------------------------------------------------------------------------
# BANESCO_API_URL=https://api.banesco.com/api/v1/pagos/verificar
# BANESCO_CLIENT_ID=tu-client-id-banesco
# BANESCO_CLIENT_SECRET=tu-client-secret-banesco
# BANESCO_MASTER_ACCOUNT=01340000000000000000
# BANESCO_MASTER_PHONE=04141234567
# BANESCO_MASTER_RIF=J123456789
